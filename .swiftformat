# Formatting only: preserve behavior, public names, storage keys and comments.
--swift-version 6.0
--indent 4
--max-width 110
--semicolons never
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-conditions before-first
--rules indent,linebreaks,linebreakAtEndOfFile,spaceAroundBraces,spaceAroundBrackets,spaceAroundGenerics,spaceAroundOperators,spaceAroundParens,spaceInsideBraces,spaceInsideBrackets,spaceInsideGenerics,spaceInsideParens,trailingSpace,semicolons,wrap,wrapArguments,wrapFunctionBodies,wrapGuardStatementBodies,wrapIfStatementBodies,wrapLoopBodies,wrapPropertyBodies,wrapSwitchCases,wrapCaseBodies,elseOnSameLine,wrapEnumCases,blankLinesBetweenScopes
--exclude Finn/Vendor
