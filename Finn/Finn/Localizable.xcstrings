        }
      }
    },
    "Finn needs at least four measured reps before it can show an observation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn a besoin d’au moins quatre répétitions mesurées pour faire une observation."
