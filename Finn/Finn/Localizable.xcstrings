    "Choose English (UK), English (US), French or Spanish in iPhone Settings. Finn uses your region for dates and numbers." : {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’anglais (Royaume-Uni), l’anglais (États-Unis), le français ou l’espagnol dans les réglages de l’iPhone. Finn utilise votre région pour les dates et les nombres."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose English (UK), English (US), French or Spanish in iPhone Settings. Finn uses your region for dates and numbers."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose English (UK), English (US), French or Spanish in iPhone Settings. Finn uses your region for dates and numbers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige inglés (Reino Unido), inglés (Estados Unidos), francés o español en Ajustes del iPhone. Finn usa tu región para las fechas y los números."
          }
        }
      }
    },
