    "The first-launch screens: your goal, your exercises, your level, the voice, and where to put your iPhone. Your choices set exercise order and help Coach select relevant saved sets." : {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The first-launch screens: your goal, your exercises, your level, the voice, and where to put your iPhone. Your choices set exercise order and help Coach select relevant saved sets."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The first-launch screens: your goal, your exercises, your level, the voice, and where to put your iPhone. Your choices set exercise order and help Coach select relevant saved sets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écrans de bienvenue : votre objectif, vos exercices, votre niveau, la voix et où placer votre iPhone. Vos choix définissent l’ordre des exercices et aident Coach à sélectionner les séries enregistrées pertinentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pantallas de bienvenida: tu objetivo, tus ejercicios, tu nivel, la voz y dónde colocar el iPhone. Tus elecciones ordenan los ejercicios y ayudan a Coach a seleccionar las series guardadas pertinentes."
          }
        }
      }
    },
    "This removes saved sessions, awards and preferences from this iPhone." : {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes saved sessions, awards and preferences from this iPhone."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes saved sessions, awards and preferences from this iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les séances enregistrées, les récompenses et les préférences de cet iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina las sesiones guardadas, los premios y las preferencias de este iPhone."
          }
        }
      }
    },
    "This removes saved sessions, awards and preferences from this iPhone. Workouts saved to Apple Health stay there; you can delete them in the Health app." : {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes saved sessions, awards and preferences from this iPhone. Workouts saved to Apple Health stay there; you can delete them in the Health app."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes saved sessions, awards and preferences from this iPhone. Workouts saved to Apple Health stay there; you can delete them in the Health app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les séances enregistrées, les récompenses et les préférences de cet iPhone. Les entraînements enregistrés dans Apple Santé y restent ; vous pouvez les supprimer dans l’app Santé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina las sesiones guardadas, los premios y las preferencias de este iPhone. Los entrenamientos guardados en Salud de Apple permanecen allí; puedes eliminarlos en la app Salud."
          }
        }
      }
    }
  },
