    "Elbow bend is how much your elbow angle closed from the starting position, as seen by the camera. Use it only to compare your own sets from the same view." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flexion du coude indique de combien l’angle de ton coude s’est fermé depuis la position de départ, vu par la caméra. Sers-t’en seulement pour comparer tes propres séries filmées sous le même angle."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbow bend is how much your elbow angle closed from the starting position, as seen by the camera. Use it only to compare your own sets from the same view."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbow bend is how much your elbow angle closed from the starting position, as seen by the camera. Use it only to compare your own sets from the same view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flexión del codo indica cuánto se cerró el ángulo de tu codo desde la posición inicial, visto por la cámara. Úsalo solo para comparar tus propias series grabadas desde el mismo ángulo."
          }
        }
      }
    },
