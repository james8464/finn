          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach usa tu pregunta y los resúmenes de tus series guardadas. Cuando está disponible, Apple Intelligence los procesa en este iPhone. Nunca se incluyen imágenes de la cámara ni puntos de postura sin procesar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach utilise ta question et les résumés de tes séries enregistrées. Lorsqu’Apple Intelligence est disponible, le traitement se fait sur cet iPhone. Les images de la caméra et les points de pose bruts ne sont jamais inclus."
          }
        }
      }
    },
