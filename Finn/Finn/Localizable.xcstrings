        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone taps at the start and end of a set; Apple Watch taps each rep. Optional tones mark the set. Sounds respect Silent Mode and play alongside your music."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone taps at the start and end of a set; Apple Watch taps each rep. Optional tones mark the set. Sounds respect Silent Mode and play alongside your music."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone vibra al empezar y terminar una serie; el Apple Watch vibra con cada repetición. Los tonos opcionales señalan el inicio y el final. Los sonidos respetan el modo Silencio y se mezclan con tu música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone vibre au début et à la fin d’une série ; l’Apple Watch vibre à chaque répétition. Des sons facultatifs marquent la série. Ils respectent le mode Silence et se mêlent à votre musique."
          }
        }
      }
    },
