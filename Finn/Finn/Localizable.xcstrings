    "Yesterday looked heavy, with %lld minutes of workouts. A lighter session today could help you recover." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grosse journée hier, avec %lld minutes d’entraînement. Une séance plus légère aujourd’hui peut t’aider à récupérer."
          }
