          "stringUnit": {
            "state": "translated",
            "value": "Ayer fue un día pesado, con %lld minutos de entrenamiento. Una sesión más ligera hoy podría ayudarte a recuperarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grosse journée hier, avec %lld minutes d’entraînement. Une séance plus légère aujourd’hui peut t’aider à récupérer."
          }
        }
      }
    },
