        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn saw the joints clearly for only part of the set, so it made no observation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn solo vio claramente las articulaciones durante parte de la serie, por lo que no realizó ninguna observación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn n’a bien vu tes articulations que sur une partie de la série, donc il ne fait pas d’observation."
          }
        }
      }
    },
    "Finn saw this set only partly, so it doesn’t compare it with your earlier sets.": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn saw this set only partly, so it doesn’t compare it with your earlier sets."
