          "stringUnit": {
            "state": "translated",
            "value": "Finn démarre la série dès qu’il te voit bien et que tu restes immobile."
          }
        }
      }
    },
    "Finn uses the camera to measure a supported exercise from the side. Camera frames and pose points stay on this iPhone.": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn uses the camera to measure a supported exercise from the side. Camera frames and pose points stay on this iPhone."
