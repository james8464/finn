          "width": 1264,
          "gap": 24,
          "children": [
            {
              "type": "text",
              "id": "GDYaG",
              "name": "State",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 230,
              "content": "FAILURE",
              "fontFamily": "Inter",
