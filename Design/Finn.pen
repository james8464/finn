            },
            {
              "type": "text",
              "id": "ENrGy",
              "name": "Say",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 445,
              "content": "Keep the visible count. Name the unclear joint or missing view.",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "PGJZZ",
              "name": "Next step",
              "fill": "#525257ff",
              "textGrowth": "fixed-width",
              "width": 541,
              "content": "Suggest a concrete framing adjustment.",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "aPOv0",
          "name": "Divider",
          "fill": "#dbd9d4ff",
          "width": 1264,
          "height": 1
        },
        {
          "type": "frame",
          "id": "zaSis",
          "name": "Retake",
          "clip": true,
          "width": 1264,
          "gap": 24,
          "children": [
            {
              "type": "text",
              "id": "it3bp",
              "name": "State",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 230,
              "content": "RETAKE",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fu3OK",
              "name": "Say",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 445,
              "content": "Explain what prevented a measured result.",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "FKhTT",
              "name": "Next step",
              "fill": "#525257ff",
              "textGrowth": "fixed-width",
              "width": 541,
              "content": "Show the view or body position to change.",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "c1XMEO",
          "name": "Divider",
          "fill": "#dbd9d4ff",
          "width": 1264,
          "height": 1
        },
        {
          "type": "frame",
          "id": "LL1RJ",
          "name": "Analysis failure",
