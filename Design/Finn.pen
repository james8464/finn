              "name": "Say",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 445,
              "content": "“No specific change detected in this set.” Avoid “perfect form.”",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "UW7yV",
              "name": "Next step",
              "fill": "#525257ff",
              "textGrowth": "fixed-width",
              "width": 541,
              "content": "Offer another set or history without invented advice.",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "WBgSy",
          "name": "Divider",
          "fill": "#dbd9d4ff",
          "width": 1264,
          "height": 1
        },
        {
          "type": "frame",
