            },
            {
              "type": "text",
              "id": "woIRn",
              "name": "Notes",
              "fill": "#4f4f54ff",
              "textGrowth": "fixed-width",
              "width": 1210,
              "content": "CURRENT  ·  Home uses a dark amber image, translucent cards, a lime selection, and native workout screens. Some dashboard destinations are marked placeholders.\nPROPOSED  ·  Replace the Home lime accent with #FF2D92. Keep the artwork decorative and the workout flow semantic and native.\nLATER  ·  Validate new exercise cues, progress views, and accessory behavior with physical-device evidence before treating them as release-ready.",
              "fontFamily": "Inter",
              "fontSize": 19,
              "fontWeight": "normal"
            }
          ]
        },
