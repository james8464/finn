          "height": 1
        },
        {
          "type": "text",
          "id": "q5sgp3",
          "name": "Section",
          "fill": "#ff2d92ff",
          "textGrowth": "fixed-width",
          "width": 1264,
          "content": "02 / INTERACTION CHECKS",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "Tt5hN",
          "name": "Heading",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1264,
          "content": "Preserve the person’s control",
          "fontFamily": "Inter",
          "fontSize": 39,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "bbZah",
          "name": "Context",
          "fill": "#525257ff",
          "textGrowth": "fixed-width",
          "width": 1180,
          "content": "Review these on a physical iPhone and at accessibility text sizes.",
          "fontFamily": "Inter",
          "fontSize": 20,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "b2fDKK",
          "name": "Check",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1210,
          "content": "—  Camera prompt follows a plain explanation of local processing and no saved video.",
          "fontFamily": "Inter",
          "fontSize": 19,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "j85iKG",
          "name": "Check",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1210,
          "content": "—  Live count and framing status remain legible over light and dark camera pixels.",
          "fontFamily": "Inter",
          "fontSize": 19,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Cm0MF",
          "name": "Check",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1210,
          "content": "—  Start and Stop set are reachable, labeled, and understandable without colour.",
          "fontFamily": "Inter",
          "fontSize": 19,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "wCEwj",
          "name": "Check",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1210,
          "content": "—  Dynamic Type keeps the primary action and result in a usable scroll order.",
          "fontFamily": "Inter",
          "fontSize": 19,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "zO2aq",
          "name": "Check",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1210,
          "content": "—  VoiceOver reads exercise, capture state, count, result, evidence, and action in that order.",
          "fontFamily": "Inter",
          "fontSize": 19,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "sn00M",
          "name": "Check",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1210,
          "content": "—  Reduce Motion removes nonessential transitions; Reduce Transparency gives controls a solid ground.",
          "fontFamily": "Inter",
          "fontSize": 19,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "gM2lN",
          "name": "Check",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1210,
          "content": "—  Home pink is for selection and small highlights; destructive actions remain semantic red.",
          "fontFamily": "Inter",
          "fontSize": 19,
          "fontWeight": "normal"
        },
        {
          "type": "rectangle",
          "id": "MXcLm",
          "name": "Divider",
          "fill": "#dbd9d4ff",
          "width": 1264,
          "height": 1
        },
        {
          "type": "text",
          "id": "tU0jM",
          "name": "Section",
          "fill": "#ff2d92ff",
          "textGrowth": "fixed-width",
          "width": 1264,
          "content": "03 / OPEN DESIGN QUESTIONS",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "TiQGJ",
          "name": "Heading",
          "fill": "#121212ff",
          "textGrowth": "fixed-width",
          "width": 1264,
          "content": "Keep these visible",
          "fontFamily": "Inter",
          "fontSize": 39,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "PcwQO",
          "name": "Context",
          "fill": "#525257ff",
          "textGrowth": "fixed-width",
          "width": 1180,
          "content": "Do not silently turn an exploration into a release claim.",
          "fontFamily": "Inter",
          "fontSize": 20,
          "fontWeight": "normal"
        },
