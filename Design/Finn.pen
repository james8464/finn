        },
        {
          "type": "text",
          "id": "eDv9b",
          "name": "Small note",
          "fill": "#525257ff",
          "textGrowth": "fixed-width",
          "width": 1180,
          "content": "Copy above is a design reference, not a promise that every exercise supports every observation. Validate against current rules and localization before shipping.",
