        },
        {
          "type": "frame",
          "id": "sRGI9",
          "name": "01 / The job",
          "clip": true,
          "width": 1264,
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "TQEvR",
              "name": "Section number",
              "fill": "#ff2d92ff",
              "textGrowth": "fixed-width",
              "width": 1264,
              "content": "01",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "Ky8bD",
              "name": "Heading",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 1264,
              "content": "The job",
              "fontFamily": "Inter",
              "fontSize": 31,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "K3151k",
              "name": "Notes",
              "fill": "#4f4f54ff",
              "textGrowth": "fixed-width",
              "width": 1210,
              "content": "Train alone. Put the phone down. Complete a set without managing the interface mid-rep. Afterwards, see one observation the camera actually supports and one useful adjustment for the next set.",
              "fontFamily": "Inter",
              "fontSize": 19,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "a9IHg6",
          "name": "Divider",
          "fill": "#d9d6d1ff",
          "width": 1264,
          "height": 1
        },
        {
          "type": "frame",
          "id": "C1Aup9",
          "name": "02 / The loop",
          "clip": true,
          "width": 1264,
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "Qjf29",
              "name": "Section number",
              "fill": "#ff2d92ff",
              "textGrowth": "fixed-width",
              "width": 1264,
              "content": "02",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "FY6Hl",
              "name": "Heading",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 1264,
              "content": "The loop",
              "fontFamily": "Inter",
              "fontSize": 31,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "Pa92e",
              "name": "Notes",
              "fill": "#4f4f54ff",
              "textGrowth": "fixed-width",
              "width": 1210,
              "content": "CHOOSE A MOVEMENT   →   FRAME THE BODY   →   COUNT A SET   →   REVIEW THE RESULT   →   TRY AGAIN\n\nNo account or accessory is needed. The camera analyzes frames on the iPhone; video is not saved or uploaded. The next set should feel like a continuation, not a new setup.",
              "fontFamily": "Inter",
              "fontSize": 19,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "aMgVr",
          "name": "Divider",
          "fill": "#d9d6d1ff",
          "width": 1264,
          "height": 1
        },
        {
          "type": "frame",
          "id": "r7ScW",
          "name": "03 / What the result can say",
          "clip": true,
          "width": 1264,
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "a2eok",
              "name": "Section number",
              "fill": "#ff2d92ff",
              "textGrowth": "fixed-width",
              "width": 1264,
              "content": "03",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "la3v1",
              "name": "Heading",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 1264,
              "content": "What the result can say",
              "fontFamily": "Inter",
              "fontSize": 31,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "b7nSK",
              "name": "Notes",
              "fill": "#4f4f54ff",
              "textGrowth": "fixed-width",
              "width": 1210,
              "content": "Measured observation — name the change, show which reps support it, offer one next-set action.\nNo supported pattern — the set was measurable, but no specific correction is supported.\nPartial set — keep the visible count, name what was obscured, withhold posture advice.\nRetake — explain how to change camera view or framing.\nAnalysis failure — explain the technical problem and offer retry.",
              "fontFamily": "Inter",
              "fontSize": 19,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "j3aByK",
          "name": "Divider",
          "fill": "#d9d6d1ff",
          "width": 1264,
          "height": 1
        },
        {
          "type": "frame",
          "id": "vTsrt",
          "name": "04 / The hard boundary",
          "clip": true,
          "width": 1264,
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "k5XRK",
              "name": "Section number",
              "fill": "#ff2d92ff",
              "textGrowth": "fixed-width",
              "width": 1264,
              "content": "04",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "HGkFB",
              "name": "Heading",
              "fill": "#121212ff",
              "textGrowth": "fixed-width",
              "width": 1264,
              "content": "The hard boundary",
              "fontFamily": "Inter",
              "fontSize": 31,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "wvrJe",
              "name": "Notes",
              "fill": "#4f4f54ff",
              "textGrowth": "fixed-width",
              "width": 1210,
              "content": "A single camera cannot infer force, pain, load, or every joint. Never turn a clean-looking frame into “good form,” injury prevention, or a diagnosis. If confidence is insufficient, show what is missing. Trust comes from a precise abstention.",
              "fontFamily": "Inter",
              "fontSize": 19,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "rsmF3",
          "name": "Divider",
          "fill": "#d9d6d1ff",
          "width": 1264,
          "height": 1
        },
        {
          "type": "frame",
          "id": "j4dRK",
          "name": "05 / Current / proposed / later",
          "clip": true,
          "width": 1264,
          "layout": "vertical",
