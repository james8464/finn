            "value" : "Tu n’as encore mesuré aucune série dans Plumb. Dis « Lance une série de squats dans Plumb » pour commencer."
          }
        }
      }
    },
    "You seem less recovered than usual: your heart rate variability is %lld ms, against %lld ms on average this week." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You seem less recovered than usual: your heart rate variability is %1$lld ms, against %2$lld ms on average this week."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta récupération semble moins bonne que d’habitude : ta variabilité cardiaque est de %1$lld ms, contre %2$lld ms en moyenne cette semaine."
          }
        }
      }
    },
    "You seem less recovered than usual: your resting heart rate is %@, against %@ on average this week." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You seem less recovered than usual: your resting heart rate is %1$@, against %2$@ on average this week."
