          }
        }
      }
    },
    "Yesterday was much busier than usual: %lld kcal of active energy, against %lld on a usual day. Go easier if you feel it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Yesterday was much busier than usual: %1$lld kcal of active energy, against %2$lld on a usual day. Go easier if you feel it."
          }
        },
        "fr" : {
          "stringUnit" : {
