        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur %3$lld répétitions, %1$@ médiane a gagné %2$lld %% par rapport à ta série précédente de la séance."
          }
        }
      }
    },
    "Median of the measured reps of each session." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Médiane des répétitions mesurées de chaque séance."
