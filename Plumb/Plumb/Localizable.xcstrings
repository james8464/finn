        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier, %@"
          }
        }
      }
    },
    "You can move the damaged file aside and start a new local history." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux mettre de côté le fichier abîmé et repartir sur un nouvel historique local."
          }
        }
      }
    },
    "You haven't measured a set in Plumb yet. Say \"Start a squat set in Plumb\" to begin." : {
      "comment" : "Siri, when the history is empty",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
