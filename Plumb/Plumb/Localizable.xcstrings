          "stringUnit" : {
            "state" : "translated",
            "value" : "Monte les hanches"
          }
        }
      }
    },
    "Lighter session today? You slept %@ last night." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance plus légère aujourd’hui ? Tu as dormi %@ cette nuit."
          }
        }
      }
    },
    "Listen to observation" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écouter l’observation"
          }
        }
      }
    },
    "Longer %@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Longer %1$@, %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en hausse, %2$@"
          }
        }
      }
    },
    "Lower your back knee toward the floor until your front thigh is close to level." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descends le genou arrière vers le sol jusqu’à ce que ta cuisse avant soit presque à l’horizontale."
          }
        }
      }
    },
    "Lower your chest until your elbows reach about 90°, or do fewer reps you can take all the way down." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descends la poitrine jusqu’à ce que tes coudes arrivent vers 90°, ou fais moins de répétitions mais en amplitude complète."
          }
        }
      }
    },
    "Lower your hips" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baisse les hanches"
          }
        }
      }
    },
    "Lower your hips until your shoulders, hips and ankles line up." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baisse les hanches jusqu’à aligner épaules, hanches et chevilles."
