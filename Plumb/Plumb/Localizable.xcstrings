          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes hanches sont passées sous la ligne épaules-chevilles %1$@, d’environ %2$lld %% de la longueur de ton buste."
          }
        }
      }
    },
    "Your hips sat lower relative to your shoulder-to-ankle line in the last two reps." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes hanches étaient plus basses que la ligne épaules-chevilles sur les deux dernières répétitions."
          }
        }
      }
    },
    "Your hips stayed above your knees at the bottom %@: your thighs were about %lld° above level." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your hips stayed above your knees at the bottom %1$@: your thighs were about %2$lld° above level."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes hanches sont restées au-dessus de tes genoux en bas du mouvement %1$@ : tes cuisses étaient environ %2$lld° au-dessus de l’horizontale."
          }
        }
      }
    },
    "Your hips swung about %lld%% of your arm length forward and back. A still body makes each rep count the same." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes hanches ont balancé d’avant en arrière d’environ %lld %% de la longueur de ton bras. Un corps immobile rend chaque répétition comparable."
          }
        }
      }
    },
    "Your hips went down about %lld cm on your deepest squat." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes hanches sont descendues d’environ %lld cm sur ton squat le plus profond."
          }
        }
      }
    },
    "Your knee bend became smaller in the last two reps." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta flexion du genou a diminué sur les deux dernières répétitions."
          }
        }
      }
    },
    "Your knees bent about %lld° at the bottom of the hinge %@, more like a squat than a stiff-leg deadlift." : {
