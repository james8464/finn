      }
    },
    "This iPhone cannot run Apple Intelligence, so the coach answers from Plumb's records only." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas faire tourner Apple Intelligence : le coach répond seulement d'après les enregistrements de Plumb."
