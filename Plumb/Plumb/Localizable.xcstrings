      }
    },
    "Measured reps" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répétitions mesurées"
          }
        }
      }
    },
    "Measured set summaries are saved on this iPhone so you can review previous sets. They include which measured patterns each set showed, so Plumb can point out your most frequent one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résumés des séries mesurées restent sur cet iPhone pour que tu puisses revoir tes séries précédentes. Ils notent les tendances mesurées sur chaque série, pour que Plumb puisse te signaler la plus fréquente."
          }
        }
      }
    },
    "Median %@ %lld%% longer than in your previous set of that session, over %lld reps." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Median %1$@ %2$lld%% longer than in your previous set of that session, over %3$lld reps."
