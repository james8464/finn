    "Make Plumb more personal?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personnaliser Plumb ?"
          }
        }
      }
    },
    "Measure at least one set of each of the six exercises." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure au moins une série de chacun des six exercices."
          }
        }
      }
    },
    "Measure sets on three different days within seven days." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure des séries sur trois jours différents en une semaine."
          }
        }
      }
    },
    "Measured from one side camera view; not a full technique assessment." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesuré depuis une seule vue de profil ; ce n’est pas une évaluation complète de la technique."
          }
