        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta récupération semble moins bonne que d’habitude : ta fréquence cardiaque au repos est de %1$@, contre %2$@ en moyenne cette semaine."
          }
        }
      }
    },
    "You walked far more than usual yesterday: %lld steps, against %lld on a usual day. Go easier if your legs feel it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You walked far more than usual yesterday: %1$lld steps, against %2$lld on a usual day. Go easier if your legs feel it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as bien plus marché que d’habitude hier : %1$lld pas, contre %2$lld un jour normal. Vas-y plus doucement si tes jambes le sentent."
          }
        }
      }
    },
    "Your Plumb" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Plumb"
          }
        }
      }
    },
    "Your body swung more at the top of the last two reps." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton corps s’est plus balancé en haut des deux dernières répétitions."
          }
        }
      }
    },
    "Your chest dropped forward at the bottom %@: your torso leaned about %lld° more than your shins." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your chest dropped forward at the bottom %1$@: your torso leaned about %2$lld° more than your shins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta poitrine a plongé en bas du mouvement %1$@ : ton buste était penché d’environ %2$lld° de plus que tes tibias."
          }
        }
      }
    },
    "Your earlier sets were filmed from your other side, so Plumb can’t compare them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes séries précédentes ont été filmées de l’autre côté, donc Plumb ne peut pas les comparer."
          }
        }
      }
    },
    "Your elbow bend became smaller in the last two reps." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta flexion du coude a diminué sur les deux dernières répétitions."
          }
        }
      }
    },
    "Your elbows stayed at about %lld° at the bottom %@. A full push-up brings them to about 90°." : {
