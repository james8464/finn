    "Rhythm is a pacing guide, not a form judgement. It starts a temporary Watch workout for taps with your wrist down. That workout is discarded; your iPhone controls Fitness saving." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rythme t’aide à cadencer tes répétitions ; il ne juge pas ta technique. Il lance une séance temporaire sur la montre pour les vibrations poignet baissé. Cette séance est supprimée : l’iPhone gère l’enregistrement dans Forme."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rhythm is a pacing guide, not a form judgment. It starts a temporary Watch workout for taps with your wrist down. That workout is discarded; your iPhone controls Fitness saving."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rhythm is a pacing guide, not a form judgement. It starts a temporary Watch workout for taps with your wrist down. That workout is discarded; your iPhone controls Fitness saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ritmo te ayuda a marcar el paso; no evalúa tu técnica. Inicia un entrenamiento temporal en el reloj para vibrar con la muñeca bajada. Ese entrenamiento se descarta: el iPhone controla lo que se guarda en Fitness."
          }
        }
      }
    },
    "Turn on haptics in iPhone settings to use Watch rhythm." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active les vibrations dans les réglages de l’iPhone pour utiliser le rythme sur la montre."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on haptics in iPhone settings to use Watch rhythm."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on haptics in iPhone settings to use Watch rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la respuesta háptica en los ajustes del iPhone para usar el ritmo en el reloj."
          }
        }
      }
    },
    "Allow temporary Watch workouts in Health settings to turn on rhythm." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
